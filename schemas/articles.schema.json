  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
    },
    "visibility": {
      "type": "string",
      "const": "public"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "dek": {
      "type": "string",
      "minLength": 1
    },
    "byline": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "simDate": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "report",
        "analysis",
        "opinion",
        "interview",
        "bulletin"
      ]
    },
    "illustration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^press\\/[a-z0-9-]+\\/[a-z0-9-]+\\.svg$"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "default": "",
              "type": "string"
            },
            "credit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "src",
            "alt",
            "credit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refs": {
      "default": {
        "bills": [],
        "divisions": [],
        "institutions": [],
        "events": [],
        "elections": [],
        "documents": [],
        "parties": []
