          "items": {
            "type": "string",
            "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          }
        },
        "institutions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          }
        },
        "events": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          }
        },
        "elections": {
          "default": [],
          "type": "array",
