      "type": "string",
      "enum": [
        "endowment",
        "assembly",
        "deferral",
        "reserve"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "billId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reach": {
      "type": "string",
      "enum": [
        "near",
        "far",
        "mixed",
        "not-applicable"
      ]
    },
    "steward": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "allocated",
        "committed",
        "reached",
        "used"
      ]
    },
    "stageHistory": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "allocated",
              "committed",
              "reached",
              "used"
