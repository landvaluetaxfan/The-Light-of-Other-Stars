{
  "$comment": "Public data contract v1.0.0 — generated from src/lib/data/schema.ts; do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
    },
    "visibility": {
      "type": "string",
      "const": "public"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "newspaper",
        "magazine",
        "newsletter",
        "broadcaster"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "demonstration",
        "active",
        "ceased"
      ]
    },
    "ownerLabel": {
      "type": "string",
      "minLength": 1
    },
    "ownerMemberId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "editorLabel": {
      "type": "string",
      "minLength": 1
    },
    "founded": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "editorialStance": {
      "type": "string",
      "minLength": 1
    },
    "affiliation": {
      "type": "string",
      "enum": [
        "independent",
        "party-affiliated"
      ]
    },
    "affiliatedPartyId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(DEMO-)?[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "broadsheet",
            "broadcast",
            "editorial"
          ]
        },
        "logo": {
          "type": "string",
          "pattern": "^press\\/[a-z0-9-]+\\/[a-z0-9-]+\\.svg$"
        },
        "displayFont": {
          "type": "string",
          "enum": [
            "playfair",
            "archivo",
            "fraunces",
            "plex-sans",
            "source-serif"
          ]
        },
        "bodyFont": {
          "type": "string",
          "enum": [
            "playfair",
            "archivo",
            "fraunces",
            "plex-sans",
            "source-serif"
          ]
        },
        "colors": {
          "type": "object",
          "properties": {
            "paper": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ink": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "rule": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "paper",
            "ink",
            "accent",
            "rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "theme",
        "logo",
        "displayFont",
        "bodyFont",
        "colors"
      ],
      "additionalProperties": false
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "visibility",
    "slug",
    "name",
    "kind",
    "status",
    "ownerLabel",
    "ownerMemberId",
    "editorLabel",
    "founded",
    "tagline",
    "description",
    "editorialStance",
    "affiliation",
    "affiliatedPartyId",
    "brand",
    "sections"
  ],
  "additionalProperties": false
}
