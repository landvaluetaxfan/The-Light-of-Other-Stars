{
  "name": "light-of-other-stars-information-service",
  "version": "1.0.0",
  "private": true,
  "description": "World Assembly for Extrasolar Resources — public information and parliamentary records portal for The Light of Other Stars.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate-data.ts",
    "schemas": "node scripts/export-schemas.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "astro check",
    "build": "npm run validate && astro build && node scripts/check-links.ts",
    "preview": "astro preview",
    "guides:pdf": "node scripts/make-guide-pdfs.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "astro": "^7.4.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
