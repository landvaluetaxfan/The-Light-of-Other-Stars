---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Panel from '../../components/Panel.astro';
import Badge from '../../components/Badge.astro';
import { getStore } from '../../lib/data/load.ts';
import { href, fmtSim, romanTerm } from '../../lib/site.ts';

const s = getStore();
const terms = [...s.terms].sort((a, b) => a.number - b.number);
const count = (termId: string, ds: string) => ({
  bills: s.bills.filter((b) => b.termId === termId && b.dataset === ds).length,
  divisions: s.divisions.filter((d) => d.termId === termId && d.dataset === ds).length,
  events: s.events.filter((e) => e.termId === termId && e.dataset === ds).length,
});
const TONE = { current: 'ok', scheduled: 'neutral', concluded: 'steel' } as const;
---
<BaseLayout title="Archive" section="archive" crumbs={[{ label: 'Archive' }]} description="Term-by-term archive of the public record.">
  <div class="page-head">
    <div>
      <div class="kicker">Historical archive</div>
      <h1>Archive by term</h1>
      <p class="lede">One real month is one term, representing ten simulated years. Each term's record gathers its measures, divisions, bulletins, elections and ledger entries.</p>
    </div>
  </div>
  <Panel title="Terms" flush>
    <table class="tbl stack">
      <thead><tr><th scope="col">Term</th><th scope="col">Simulated period</th><th scope="col">Status</th><th scope="col" class="num">Measures</th><th scope="col" class="num">Divisions</th><th scope="col" class="num">Bulletins</th></tr></thead>
      <tbody>
        {terms.map((t) => {
          const c = count(t.id, 'canonical');
          const d = count(t.id, 'demonstration');
          return (
            <tr>
              <td class="primary"><a href={href(`/archive/${t.id}/`)}>Term {romanTerm(t.number)} — {t.name}</a></td>
              <td data-label="Period">{fmtSim(t.simStart)} – {fmtSim(t.simEnd)}</td>
              <td data-label="Status"><Badge tone={TONE[t.status]}>{t.status}</Badge></td>
              <td data-label="Measures" class="num">{c.bills}{d.bills ? <span class="small muted"> (+{d.bills} demo)</span> : ''}</td>
              <td data-label="Divisions" class="num">{c.divisions}{d.divisions ? <span class="small muted"> (+{d.divisions} demo)</span> : ''}</td>
              <td data-label="Bulletins" class="num">{c.events}{d.events ? <span class="small muted"> (+{d.events} demo)</span> : ''}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </Panel>
</BaseLayout>
