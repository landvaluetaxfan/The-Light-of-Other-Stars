---
/**
 * The Assembly's emblem: seven interlocking circles (a "seed of life" figure),
 * drawn in the current text colour so it reads white on the masthead and
 * black in print.
 */
interface Props { class?: string; title?: string }
const { class: cls = 'emblem', title = 'Emblem of the World Assembly for Extrasolar Resources' } = Astro.props;
const C = 32;
const R = 14;
const centers = [[C, C], ...Array.from({ length: 6 }, (_, k) => [C + R * Math.cos((k * Math.PI) / 3), C + R * Math.sin((k * Math.PI) / 3)])];
---
<svg class={cls} viewBox="0 0 64 64" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <g fill="none" stroke="currentColor" stroke-width="1.5">
    {centers.map(([x, y]) => <circle cx={x.toFixed(3)} cy={y.toFixed(3)} r={R} />)}
  </g>
</svg>
