---
/**
 * Accessible parliamentary seating diagram. The SVG is a picture; the data is
 * always also given as a table by the caller (see CompositionView, Division page).
 */
import { hemicycleLayout, assignSeats, type Segment } from '../lib/hemicycle.ts';
interface Props {
  segments: Segment[];
  total: number;
  title: string;
  desc: string;
  centerLabel?: string;
  centerSub?: string;
  emptyLabel?: string;
  legend?: boolean;
}
const { segments, total, title, desc, centerLabel, centerSub, emptyLabel = 'Seat not yet assigned', legend = true } = Astro.props;
const layout = hemicycleLayout(total);
const groups = assignSeats(layout, segments);
const uid = `hc${Math.random().toString(36).slice(2, 8)}`;
const cx = layout.width / 2;
---
<figure class="hemi-fig" style="margin:0">
  <svg class="hemicycle" viewBox={`0 0 ${layout.width} ${layout.height}`} role="img" aria-labelledby={`${uid}-t ${uid}-d`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${uid}-t`}>{title}</title>
    <desc id={`${uid}-d`}>{desc}</desc>
    <defs>
      <pattern id={`${uid}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" fill="#d9dedb" />
        <line x1="0" y1="0" x2="0" y2="6" stroke="#8d9995" stroke-width="2" />
      </pattern>
    </defs>
    {groups.map((g) => (
      <g fill={g.seg ? (g.seg.hatch ? `url(#${uid}-hatch)` : g.seg.color) : '#ffffff'} stroke={g.seg ? 'rgba(0,0,0,0.28)' : '#9aa6a2'} stroke-width={g.seg ? 0.8 : 1.2}>
        <title>{g.seg ? `${g.seg.label}: ${g.seg.count} seats` : `${emptyLabel}: ${g.seats.length} seats`}</title>
        {g.seats.map((p) => <circle cx={p.x} cy={p.y} r={layout.seatR} />)}
      </g>
    ))}
    {centerLabel && (
      <text x={cx} y={layout.height - 46} text-anchor="middle" font-family="IBM Plex Sans, Segoe UI, Arial, sans-serif" font-size="44" font-weight="600" fill="#1d2a2e">{centerLabel}</text>
    )}
    {centerSub && (
      <text x={cx} y={layout.height - 14} text-anchor="middle" font-family="IBM Plex Sans, Segoe UI, Arial, sans-serif" font-size="20" fill="#66757a">{centerSub}</text>
    )}
  </svg>
  {legend && (
    <ul class="legend" aria-hidden="true">
      {segments.map((sg) => (
        <li><span class="swatch" style={sg.hatch ? 'background:repeating-linear-gradient(45deg,#d9dedb 0 2px,#8d9995 2px 4px)' : `background:${sg.color}`}></span>{sg.label} <b>{sg.count}</b></li>
      ))}
      {segments.reduce((a, sg) => a + sg.count, 0) < total && (
        <li><span class="swatch" style="background:#fff"></span>{emptyLabel} <b>{total - segments.reduce((a, sg) => a + sg.count, 0)}</b></li>
      )}
    </ul>
  )}
</figure>
